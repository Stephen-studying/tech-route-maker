flowchart LR
  title["校园综合能源系统项目技术路线图"]
  subgraph boundary["系统边界"]
    boundary_scope["定义校园边界"]
    boundary_targets["设定规划目标"]
  end
  subgraph data["源荷数据"]
    data_load["构建冷热电负荷"]
    data_resource["评估新能源资源"]
    data_tariff["整理约束条件"]
  end
  subgraph model["配置模型"]
    model_assets["建模候选设备"]
    model_objective["多目标容量优化"]
    model_scenarios["比较规划场景"]
  end
  subgraph operation["运行策略"]
    operation_dispatch["制定调度策略"]
    operation_control["定义控制层级"]
  end
  subgraph validation["验证交付"]
    validation_kpi["评价系统指标"]
    validation_sensitivity["开展敏感性分析"]
    validation_deliver["交付配置方案"]
  end
